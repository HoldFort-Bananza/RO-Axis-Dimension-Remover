<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Tekla Open API 2025 działa na .NET Framework 4.8 -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>RoAxisDimensionRemover</RootNamespace>
    <AssemblyName>RoAxisDimensionRemover</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!--
      WERSJA - musi być zgodna z MyAppVersion w installer/setup.iss oraz z
      tagiem release na GitHubie. Program czyta ją z własnego assembly i
      porównuje z najnowszym tagiem przez API GitHuba (patrz UpdateCheck.cs),
      więc rozjazd tutaj = błędne powiadomienie o aktualizacji.
    -->
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tekla.Structures" Version="2025.0.0" />
    <PackageReference Include="Tekla.Structures.Drawing" Version="2025.0.0" />
    <PackageReference Include="Tekla.Structures.Model" Version="2025.0.0" />

    <!-- WYMAGANE dla architektury "gacless" 2024/2025, patrz ..\CLAUDE.md -->
    <PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" />
  </ItemGroup>

</Project>
